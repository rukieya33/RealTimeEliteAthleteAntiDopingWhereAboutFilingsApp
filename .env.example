# ---- Server ----
PORT=3000
NODE_ENV=development
# Time zone the agency works in. "Now", today's filings and 60-minute slots are evaluated in this zone.
APP_TZ=Europe/London
APP_NAME=Apex Athlete Management

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=whereabouts_app
DB_PASSWORD=change_me
DB_NAME=athlete_whereabouts

# ---- Auth ----
# Use a long random string in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@agency.test
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Compliance rules ----
# Day of the month (in the month before a quarter starts) by which the quarterly filing is due.
QUARTERLY_DEADLINE_DAY=15
# Failures within this rolling window are counted together.
FAILURE_WINDOW_MONTHS=12
# Number of failures within the window that triggers a potential rule violation flag.
FAILURE_THRESHOLD=3
# How often (seconds) the server pushes a live status refresh to connected browsers.
LIVE_TICK_SECONDS=30
