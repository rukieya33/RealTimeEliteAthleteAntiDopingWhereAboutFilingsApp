{
  "name": "realtime-elite-athlete-anti-doping-whereabouts",
  "version": "1.0.0",
  "description": "Real-time anti-doping whereabouts filing management for a sport management agency's elite athletes (Node.js, Express, MySQL).",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "node scripts/init-db.js && node scripts/seed.js",
    "import:athletes": "node scripts/import-athletes.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0"
  },
  "license": "UNLICENSED"
}
